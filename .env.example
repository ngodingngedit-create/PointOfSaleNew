# Keep the existing public Sanity Free-dataset settings unchanged.
VITE_SANITY_PROJECT_ID=aejzrj0n
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2025-02-06

# Server-only variables. Never add the service-role key, password hash, or
# session secret to a VITE_ variable or any client bundle.
