SUPABASE_SERVICE_ROLE_KEY=replace-with-the-existing-project-service-role-key
POS_SESSION_SECRET=replace-with-at-least-32-random-bytes
POS_ADMIN_USERNAME=choose-a-private-username
POS_ADMIN_PASSWORD_HASH=generate-with-npm-run-admin:hash

